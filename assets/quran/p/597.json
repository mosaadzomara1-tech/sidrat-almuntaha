{"p":597,"juz":30,"ayat":[{"s":95,"a":1,"t":"وَٱلتِّينِ وَٱلزَّيْتُونِ"},{"s":95,"a":2,"t":"وَطُورِ سِينِينَ"},{"s":95,"a":3,"t":"وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ"},{"s":95,"a":4,"t":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ"},{"s":95,"a":5,"t":"ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ"},{"s":95,"a":6,"t":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"},{"s":95,"a":7,"t":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ"},{"s":95,"a":8,"t":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ"},{"s":96,"a":1,"t":" ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"},{"s":96,"a":2,"t":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ"},{"s":96,"a":3,"t":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"},{"s":96,"a":4,"t":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"},{"s":96,"a":5,"t":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ"},{"s":96,"a":6,"t":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ"},{"s":96,"a":7,"t":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"},{"s":96,"a":8,"t":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"},{"s":96,"a":9,"t":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"},{"s":96,"a":10,"t":"عَبْدًا إِذَا صَلَّىٰٓ"},{"s":96,"a":11,"t":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"},{"s":96,"a":12,"t":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"},{"s":96,"a":13,"t":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"},{"s":96,"a":14,"t":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"},{"s":96,"a":15,"t":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"},{"s":96,"a":16,"t":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ"},{"s":96,"a":17,"t":"فَلْيَدْعُ نَادِيَهُۥ"},{"s":96,"a":18,"t":"سَنَدْعُ ٱلزَّبَانِيَةَ"},{"s":96,"a":19,"t":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩"}]}