{"p":602,"juz":30,"ayat":[{"s":106,"a":1,"t":" لِإِيلَـٰفِ قُرَيْشٍ"},{"s":106,"a":2,"t":"إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"},{"s":106,"a":3,"t":"فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ"},{"s":106,"a":4,"t":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ"},{"s":107,"a":1,"t":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"},{"s":107,"a":2,"t":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"},{"s":107,"a":3,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"s":107,"a":4,"t":"فَوَيْلٌ لِّلْمُصَلِّينَ"},{"s":107,"a":5,"t":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"s":107,"a":6,"t":"ٱلَّذِينَ هُمْ يُرَآءُونَ"},{"s":107,"a":7,"t":"وَيَمْنَعُونَ ٱلْمَاعُونَ"},{"s":108,"a":1,"t":" إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ"},{"s":108,"a":2,"t":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ"},{"s":108,"a":3,"t":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ"}]}