{"p":604,"juz":30,"ayat":[{"s":112,"a":1,"t":" قُلْ هُوَ ٱللَّهُ أَحَدٌ"},{"s":112,"a":2,"t":"ٱللَّهُ ٱلصَّمَدُ"},{"s":112,"a":3,"t":"لَمْ يَلِدْ وَلَمْ يُولَدْ"},{"s":112,"a":4,"t":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"},{"s":113,"a":1,"t":" قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"},{"s":113,"a":2,"t":"مِن شَرِّ مَا خَلَقَ"},{"s":113,"a":3,"t":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"},{"s":113,"a":4,"t":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ"},{"s":113,"a":5,"t":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"},{"s":114,"a":1,"t":" قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"},{"s":114,"a":2,"t":"مَلِكِ ٱلنَّاسِ"},{"s":114,"a":3,"t":"إِلَـٰهِ ٱلنَّاسِ"},{"s":114,"a":4,"t":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"},{"s":114,"a":5,"t":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"},{"s":114,"a":6,"t":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"}]}