{"p":585,"juz":30,"ayat":[{"s":80,"a":1,"t":" عَبَسَ وَتَوَلَّىٰٓ"},{"s":80,"a":2,"t":"أَن جَآءَهُ ٱلْأَعْمَىٰ"},{"s":80,"a":3,"t":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"},{"s":80,"a":4,"t":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ"},{"s":80,"a":5,"t":"أَمَّا مَنِ ٱسْتَغْنَىٰ"},{"s":80,"a":6,"t":"فَأَنتَ لَهُۥ تَصَدَّىٰ"},{"s":80,"a":7,"t":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"},{"s":80,"a":8,"t":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ"},{"s":80,"a":9,"t":"وَهُوَ يَخْشَىٰ"},{"s":80,"a":10,"t":"فَأَنتَ عَنْهُ تَلَهَّىٰ"},{"s":80,"a":11,"t":"كَلَّآ إِنَّهَا تَذْكِرَةٌ"},{"s":80,"a":12,"t":"فَمَن شَآءَ ذَكَرَهُۥ"},{"s":80,"a":13,"t":"فِى صُحُفٍ مُّكَرَّمَةٍ"},{"s":80,"a":14,"t":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ"},{"s":80,"a":15,"t":"بِأَيْدِى سَفَرَةٍ"},{"s":80,"a":16,"t":"كِرَامٍۭ بَرَرَةٍ"},{"s":80,"a":17,"t":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ"},{"s":80,"a":18,"t":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"},{"s":80,"a":19,"t":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"},{"s":80,"a":20,"t":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"},{"s":80,"a":21,"t":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ"},{"s":80,"a":22,"t":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"},{"s":80,"a":23,"t":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ"},{"s":80,"a":24,"t":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ"},{"s":80,"a":25,"t":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا"},{"s":80,"a":26,"t":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا"},{"s":80,"a":27,"t":"فَأَنۢبَتْنَا فِيهَا حَبًّا"},{"s":80,"a":28,"t":"وَعِنَبًا وَقَضْبًا"},{"s":80,"a":29,"t":"وَزَيْتُونًا وَنَخْلًا"},{"s":80,"a":30,"t":"وَحَدَآئِقَ غُلْبًا"},{"s":80,"a":31,"t":"وَفَـٰكِهَةً وَأَبًّا"},{"s":80,"a":32,"t":"مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ"},{"s":80,"a":33,"t":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"},{"s":80,"a":34,"t":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ"},{"s":80,"a":35,"t":"وَأُمِّهِۦ وَأَبِيهِ"},{"s":80,"a":36,"t":"وَصَـٰحِبَتِهِۦ وَبَنِيهِ"},{"s":80,"a":37,"t":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"},{"s":80,"a":38,"t":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ"},{"s":80,"a":39,"t":"ضَاحِكَةٌ مُّسْتَبْ