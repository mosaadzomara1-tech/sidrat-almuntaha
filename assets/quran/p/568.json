{"p":568,"juz":29,"ayat":[{"s":69,"a":35,"t":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ"},{"s":69,"a":36,"t":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ"},{"s":69,"a":37,"t":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ"},{"s":69,"a":38,"t":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ"},{"s":69,"a":39,"t":"وَمَا لَا تُبْصِرُونَ"},{"s":69,"a":40,"t":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"s":69,"a":41,"t":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ"},{"s":69,"a":42,"t":"وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ"},{"s":69,"a":43,"t":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ"},{"s":69,"a":44,"t":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ"},{"s":69,"a":45,"t":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ"},{"s":69,"a":46,"t":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ"},{"s":69,"a":47,"t":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ"},{"s":69,"a":48,"t":"وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ"},{"s":69,"a":49,"t":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ"},{"s":69,"a":50,"t":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَـٰفِرِينَ"},{"s":69,"a":51,"t":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ"},{"s":69,"a":52,"t":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"},{"s":70,"a":1,"t":" سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ"},{"s":70,"a":2,"t":"لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ"},{"s":70,"a":3,"t":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ"},{"s":70,"a":4,"t":"تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ"},{"s":70,"a":5,"t":"فَٱصْبِرْ صَبْرًا جَمِيلًا"},{"s":70,"a":6,"t":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا"},{"s":70,"a":7,"t":"وَنَرَىٰهُ قَرِيبًا"},{"s":70,"a":8,"t":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ"},{"s":70,"a":9,"t":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ"},{"s":70,"a":10,"t":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا"}]}