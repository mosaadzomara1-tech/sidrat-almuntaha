{"p":595,"juz":30,"ayat":[{"s":91,"a":1,"t":" وَٱلشَّمْسِ وَضُحَىٰهَا"},{"s":91,"a":2,"t":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا"},{"s":91,"a":3,"t":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"},{"s":91,"a":4,"t":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا"},{"s":91,"a":5,"t":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"},{"s":91,"a":6,"t":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا"},{"s":91,"a":7,"t":"وَنَفْسٍ وَمَا سَوَّىٰهَا"},{"s":91,"a":8,"t":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا"},{"s":91,"a":9,"t":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا"},{"s":91,"a":10,"t":"وَقَدْ خَابَ مَن دَسَّىٰهَا"},{"s":91,"a":11,"t":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ"},{"s":91,"a":12,"t":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا"},{"s":91,"a":13,"t":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا"},{"s":91,"a":14,"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا"},{"s":91,"a":15,"t":"وَلَا يَخَافُ عُقْبَـٰهَا"},{"s":92,"a":1,"t":" وَٱلَّيْلِ إِذَا يَغْشَىٰ"},{"s":92,"a":2,"t":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"},{"s":92,"a":3,"t":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"s":92,"a":4,"t":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ"},{"s":92,"a":5,"t":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"},{"s":92,"a":6,"t":"وَصَدَّقَ بِٱلْحُسْنَىٰ"},{"s":92,"a":7,"t":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ"},{"s":92,"a":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ"},{"s":92,"a":9,"t":"وَكَذَّبَ بِٱلْحُسْنَىٰ"},{"s":92,"a":10,"t":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ"},{"s":92,"a":11,"t":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"},{"s":92,"a":12,"t":"إِنَّ عَلَيْنَا لَلْهُدَىٰ"},{"s":92,"a":13,"t":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ"},{"s":92,"a":14,"t":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ"}]}