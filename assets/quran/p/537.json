{"p":537,"juz":27,"ayat":[{"s":56,"a":77,"t":"إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ"},{"s":56,"a":78,"t":"فِى كِتَـٰبٍ مَّكْنُونٍ"},{"s":56,"a":79,"t":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ"},{"s":56,"a":80,"t":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ"},{"s":56,"a":81,"t":"أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ"},{"s":56,"a":82,"t":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ"},{"s":56,"a":83,"t":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ"},{"s":56,"a":84,"t":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ"},{"s":56,"a":85,"t":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ"},{"s":56,"a":86,"t":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ"},{"s":56,"a":87,"t":"تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ"},{"s":56,"a":88,"t":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ"},{"s":56,"a":89,"t":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ"},{"s":56,"a":90,"t":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"},{"s":56,"a":91,"t":"فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"},{"s":56,"a":92,"t":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ"},{"s":56,"a":93,"t":"فَنُزُلٌ مِّنْ حَمِيمٍ"},{"s":56,"a":94,"t":"وَتَصْلِيَةُ جَحِيمٍ"},{"s":56,"a":95,"t":"إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ"},{"s":56,"a":96,"t":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"},{"s":57,"a":1,"t":" سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ"},{"s":57,"a":2,"t":"لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يُحْىِۦ وَيُمِيتُ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ"},{"s":57,"a":3,"t":"هُوَ ٱلْأَوَّلُ وَٱلْـَٔاخِرُ وَٱلظَّـٰهِرُ وَٱلْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ"}]}