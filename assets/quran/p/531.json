{"p":531,"juz":27,"ayat":[{"s":54,"a":50,"t":"وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌ كَلَمْحٍۭ بِٱلْبَصَرِ"},{"s":54,"a":51,"t":"وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍ"},{"s":54,"a":52,"t":"وَكُلُّ شَىْءٍ فَعَلُوهُ فِى ٱلزُّبُرِ"},{"s":54,"a":53,"t":"وَكُلُّ صَغِيرٍ وَكَبِيرٍ مُّسْتَطَرٌ"},{"s":54,"a":54,"t":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَنَهَرٍ"},{"s":54,"a":55,"t":"فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍ مُّقْتَدِرٍۭ"},{"s":55,"a":1,"t":" ٱلرَّحْمَـٰنُ"},{"s":55,"a":2,"t":"عَلَّمَ ٱلْقُرْءَانَ"},{"s":55,"a":3,"t":"خَلَقَ ٱلْإِنسَـٰنَ"},{"s":55,"a":4,"t":"عَلَّمَهُ ٱلْبَيَانَ"},{"s":55,"a":5,"t":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ"},{"s":55,"a":6,"t":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ"},{"s":55,"a":7,"t":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ"},{"s":55,"a":8,"t":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ"},{"s":55,"a":9,"t":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ"},{"s":55,"a":10,"t":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ"},{"s":55,"a":11,"t":"فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ"},{"s":55,"a":12,"t":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ"},{"s":55,"a":13,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":14,"t":"خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ"},{"s":55,"a":15,"t":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ"},{"s":55,"a":16,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}]}