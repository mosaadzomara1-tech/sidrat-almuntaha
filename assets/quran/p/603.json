{"p":603,"juz":30,"ayat":[{"s":109,"a":1,"t":" قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ"},{"s":109,"a":2,"t":"لَآ أَعْبُدُ مَا تَعْبُدُونَ"},{"s":109,"a":3,"t":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"},{"s":109,"a":4,"t":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ"},{"s":109,"a":5,"t":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"},{"s":109,"a":6,"t":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ"},{"s":110,"a":1,"t":" إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ"},{"s":110,"a":2,"t":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا"},{"s":110,"a":3,"t":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا"},{"s":111,"a":1,"t":" تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ"},{"s":111,"a":2,"t":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ"},{"s":111,"a":3,"t":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ"},{"s":111,"a":4,"t":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ"},{"s":111,"a":5,"t":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ"}]}