{"p":447,"juz":23,"ayat":[{"s":37,"a":25,"t":"مَا لَكُمْ لَا تَنَاصَرُونَ"},{"s":37,"a":26,"t":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ"},{"s":37,"a":27,"t":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"},{"s":37,"a":28,"t":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ"},{"s":37,"a":29,"t":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ"},{"s":37,"a":30,"t":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ"},{"s":37,"a":31,"t":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ"},{"s":37,"a":32,"t":"فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ"},{"s":37,"a":33,"t":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ"},{"s":37,"a":34,"t":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"},{"s":37,"a":35,"t":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ"},{"s":37,"a":36,"t":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ"},{"s":37,"a":37,"t":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ"},{"s":37,"a":38,"t":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ"},{"s":37,"a":39,"t":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"},{"s":37,"a":40,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"s":37,"a":41,"t":"أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ"},{"s":37,"a":42,"t":"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ"},{"s":37,"a":43,"t":"فِى جَنَّـٰتِ ٱلنَّعِيمِ"},{"s":37,"a":44,"t":"عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ"},{"s":37,"a":45,"t":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ"},{"s":37,"a":46,"t":"بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ"},{"s":37,"a":47,"t":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ"},{"s":37,"a":48,"t":"وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ"},{"s":37,"a":49,"t":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ"},{"s":37,"a":50,"t":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"},{"s":37,"a":51,"t":"قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ"}]}