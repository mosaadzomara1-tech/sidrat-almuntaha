{"p":594,"juz":30,"ayat":[{"s":89,"a":24,"t":"يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"},{"s":89,"a":25,"t":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"},{"s":89,"a":26,"t":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"},{"s":89,"a":27,"t":"يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"},{"s":89,"a":28,"t":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"},{"s":89,"a":29,"t":"فَٱدْخُلِى فِى عِبَـٰدِى"},{"s":89,"a":30,"t":"وَٱدْخُلِى جَنَّتِى"},{"s":90,"a":1,"t":" لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ"},{"s":90,"a":2,"t":"وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ"},{"s":90,"a":3,"t":"وَوَالِدٍ وَمَا وَلَدَ"},{"s":90,"a":4,"t":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ"},{"s":90,"a":5,"t":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"},{"s":90,"a":6,"t":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا"},{"s":90,"a":7,"t":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"},{"s":90,"a":8,"t":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"},{"s":90,"a":9,"t":"وَلِسَانًا وَشَفَتَيْنِ"},{"s":90,"a":10,"t":"وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ"},{"s":90,"a":11,"t":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"},{"s":90,"a":12,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"},{"s":90,"a":13,"t":"فَكُّ رَقَبَةٍ"},{"s":90,"a":14,"t":"أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ"},{"s":90,"a":15,"t":"يَتِيمًا ذَا مَقْرَبَةٍ"},{"s":90,"a":16,"t":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"},{"s":90,"a":17,"t":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ"},{"s":90,"a":18,"t":"أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ"},{"s":90,"a":19,"t":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ"},{"s":90,"a":20,"t":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ"}]}