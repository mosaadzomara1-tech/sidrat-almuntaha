{"p":584,"juz":30,"ayat":[{"s":79,"a":16,"t":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى"},{"s":79,"a":17,"t":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ"},{"s":79,"a":18,"t":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ"},{"s":79,"a":19,"t":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"},{"s":79,"a":20,"t":"فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ"},{"s":79,"a":21,"t":"فَكَذَّبَ وَعَصَىٰ"},{"s":79,"a":22,"t":"ثُمَّ أَدْبَرَ يَسْعَىٰ"},{"s":79,"a":23,"t":"فَحَشَرَ فَنَادَىٰ"},{"s":79,"a":24,"t":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ"},{"s":79,"a":25,"t":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ"},{"s":79,"a":26,"t":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ"},{"s":79,"a":27,"t":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا"},{"s":79,"a":28,"t":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا"},{"s":79,"a":29,"t":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا"},{"s":79,"a":30,"t":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ"},{"s":79,"a":31,"t":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا"},{"s":79,"a":32,"t":"وَٱلْجِبَالَ أَرْسَىٰهَا"},{"s":79,"a":33,"t":"مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ"},{"s":79,"a":34,"t":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ"},{"s":79,"a":35,"t":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ"},{"s":79,"a":36,"t":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ"},{"s":79,"a":37,"t":"فَأَمَّا مَن طَغَىٰ"},{"s":79,"a":38,"t":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"},{"s":79,"a":39,"t":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ"},{"s":79,"a":40,"t":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ"},{"s":79,"a":41,"t":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ"},{"s":79,"a":42,"t":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا"},{"s":79,"a":43,"t":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ"},{"s":79,"a":44,"t":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ"},{"s":79,"a":45,"t":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا"},{"s":79,"a":46,"t":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا"}]}