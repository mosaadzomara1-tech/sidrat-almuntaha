{"p":449,"juz":23,"ayat":[{"s":37,"a":77,"t":"وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ"},{"s":37,"a":78,"t":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"},{"s":37,"a":79,"t":"سَلَـٰمٌ عَلَىٰ نُوحٍ فِى ٱلْعَـٰلَمِينَ"},{"s":37,"a":80,"t":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"s":37,"a":81,"t":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},{"s":37,"a":82,"t":"ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ"},{"s":37,"a":83,"t":"۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"},{"s":37,"a":84,"t":"إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍ سَلِيمٍ"},{"s":37,"a":85,"t":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ"},{"s":37,"a":86,"t":"أَئِفْكًا ءَالِهَةً دُونَ ٱللَّهِ تُرِيدُونَ"},{"s":37,"a":87,"t":"فَمَا ظَنُّكُم بِرَبِّ ٱلْعَـٰلَمِينَ"},{"s":37,"a":88,"t":"فَنَظَرَ نَظْرَةً فِى ٱلنُّجُومِ"},{"s":37,"a":89,"t":"فَقَالَ إِنِّى سَقِيمٌ"},{"s":37,"a":90,"t":"فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ"},{"s":37,"a":91,"t":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ"},{"s":37,"a":92,"t":"مَا لَكُمْ لَا تَنطِقُونَ"},{"s":37,"a":93,"t":"فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ"},{"s":37,"a":94,"t":"فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ"},{"s":37,"a":95,"t":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"},{"s":37,"a":96,"t":"وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ"},{"s":37,"a":97,"t":"قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَـٰنًا فَأَلْقُوهُ فِى ٱلْجَحِيمِ"},{"s":37,"a":98,"t":"فَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَـٰهُمُ ٱلْأَسْفَلِينَ"},{"s":37,"a":99,"t":"وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ"},{"s":37,"a":100,"t":"رَبِّ هَبْ لِى مِنَ ٱلصَّـٰلِحِينَ"},{"s":37,"a":101,"t":"فَبَشَّرْنَـٰهُ بِغُلَـٰمٍ حَلِيمٍ"},{"s":37,"a":102,"t":"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَـٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَـٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِينَ"}]}