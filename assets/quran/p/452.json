{"p":452,"juz":23,"ayat":[{"s":37,"a":154,"t":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ"},{"s":37,"a":155,"t":"أَفَلَا تَذَكَّرُونَ"},{"s":37,"a":156,"t":"أَمْ لَكُمْ سُلْطَـٰنٌ مُّبِينٌ"},{"s":37,"a":157,"t":"فَأْتُوا۟ بِكِتَـٰبِكُمْ إِن كُنتُمْ صَـٰدِقِينَ"},{"s":37,"a":158,"t":"وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"},{"s":37,"a":159,"t":"سُبْحَـٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"},{"s":37,"a":160,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"s":37,"a":161,"t":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ"},{"s":37,"a":162,"t":"مَآ أَنتُمْ عَلَيْهِ بِفَـٰتِنِينَ"},{"s":37,"a":163,"t":"إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ"},{"s":37,"a":164,"t":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ"},{"s":37,"a":165,"t":"وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ"},{"s":37,"a":166,"t":"وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ"},{"s":37,"a":167,"t":"وَإِن كَانُوا۟ لَيَقُولُونَ"},{"s":37,"a":168,"t":"لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ"},{"s":37,"a":169,"t":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"s":37,"a":170,"t":"فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ"},{"s":37,"a":171,"t":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ"},{"s":37,"a":172,"t":"إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ"},{"s":37,"a":173,"t":"وَإِنَّ جُندَنَا لَهُمُ ٱلْغَـٰلِبُونَ"},{"s":37,"a":174,"t":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"s":37,"a":175,"t":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"},{"s":37,"a":176,"t":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"},{"s":37,"a":177,"t":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ"},{"s":37,"a":178,"t":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"s":37,"a":179,"t":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"},{"s":37,"a":180,"t":"سُبْحَـٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ"},{"s":37,"a":181,"t":"وَسَلَـٰمٌ عَلَى ٱلْمُرْسَلِينَ"},{"s":37,"a":182,"t":"وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ"}]}