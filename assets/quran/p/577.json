{"p":577,"juz":29,"ayat":[{"s":74,"a":48,"t":"فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ"},{"s":74,"a":49,"t":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ"},{"s":74,"a":50,"t":"كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ"},{"s":74,"a":51,"t":"فَرَّتْ مِن قَسْوَرَةٍۭ"},{"s":74,"a":52,"t":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً"},{"s":74,"a":53,"t":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْـَٔاخِرَةَ"},{"s":74,"a":54,"t":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌ"},{"s":74,"a":55,"t":"فَمَن شَآءَ ذَكَرَهُۥ"},{"s":74,"a":56,"t":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ"},{"s":75,"a":1,"t":" لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ"},{"s":75,"a":2,"t":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"},{"s":75,"a":3,"t":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"},{"s":75,"a":4,"t":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"},{"s":75,"a":5,"t":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ"},{"s":75,"a":6,"t":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ"},{"s":75,"a":7,"t":"فَإِذَا بَرِقَ ٱلْبَصَرُ"},{"s":75,"a":8,"t":"وَخَسَفَ ٱلْقَمَرُ"},{"s":75,"a":9,"t":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"},{"s":75,"a":10,"t":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"},{"s":75,"a":11,"t":"كَلَّا لَا وَزَرَ"},{"s":75,"a":12,"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"},{"s":75,"a":13,"t":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"},{"s":75,"a":14,"t":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ"},{"s":75,"a":15,"t":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"},{"s":75,"a":16,"t":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"},{"s":75,"a":17,"t":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"},{"s":75,"a":18,"t":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"},{"s":75,"a":19,"t":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"}]}