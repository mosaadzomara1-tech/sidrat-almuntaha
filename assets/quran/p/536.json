{"p":536,"juz":27,"ayat":[{"s":56,"a":51,"t":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ"},{"s":56,"a":52,"t":"لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ"},{"s":56,"a":53,"t":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"},{"s":56,"a":54,"t":"فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ"},{"s":56,"a":55,"t":"فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ"},{"s":56,"a":56,"t":"هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ"},{"s":56,"a":57,"t":"نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ"},{"s":56,"a":58,"t":"أَفَرَءَيْتُم مَّا تُمْنُونَ"},{"s":56,"a":59,"t":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ"},{"s":56,"a":60,"t":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"},{"s":56,"a":61,"t":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ"},{"s":56,"a":62,"t":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ"},{"s":56,"a":63,"t":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ"},{"s":56,"a":64,"t":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ"},{"s":56,"a":65,"t":"لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ"},{"s":56,"a":66,"t":"إِنَّا لَمُغْرَمُونَ"},{"s":56,"a":67,"t":"بَلْ نَحْنُ مَحْرُومُونَ"},{"s":56,"a":68,"t":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ"},{"s":56,"a":69,"t":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ"},{"s":56,"a":70,"t":"لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ"},{"s":56,"a":71,"t":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ"},{"s":56,"a":72,"t":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ"},{"s":56,"a":73,"t":"نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ"},{"s":56,"a":74,"t":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"},{"s":56,"a":75,"t":"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ"},{"s":56,"a":76,"t":"وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ"}]}