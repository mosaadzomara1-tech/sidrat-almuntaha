{"p":586,"juz":30,"ayat":[{"s":81,"a":1,"t":" إِذَا ٱلشَّمْسُ كُوِّرَتْ"},{"s":81,"a":2,"t":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ"},{"s":81,"a":3,"t":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ"},{"s":81,"a":4,"t":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ"},{"s":81,"a":5,"t":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ"},{"s":81,"a":6,"t":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ"},{"s":81,"a":7,"t":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ"},{"s":81,"a":8,"t":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ"},{"s":81,"a":9,"t":"بِأَىِّ ذَنۢبٍ قُتِلَتْ"},{"s":81,"a":10,"t":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ"},{"s":81,"a":11,"t":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ"},{"s":81,"a":12,"t":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ"},{"s":81,"a":13,"t":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ"},{"s":81,"a":14,"t":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ"},{"s":81,"a":15,"t":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ"},{"s":81,"a":16,"t":"ٱلْجَوَارِ ٱلْكُنَّسِ"},{"s":81,"a":17,"t":"وَٱلَّيْلِ إِذَا عَسْعَسَ"},{"s":81,"a":18,"t":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ"},{"s":81,"a":19,"t":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"s":81,"a":20,"t":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ"},{"s":81,"a":21,"t":"مُّطَاعٍ ثَمَّ أَمِينٍ"},{"s":81,"a":22,"t":"وَمَا صَاحِبُكُم بِمَجْنُونٍ"},{"s":81,"a":23,"t":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ"},{"s":81,"a":24,"t":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ"},{"s":81,"a":25,"t":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ"},{"s":81,"a":26,"t":"فَأَيْنَ تَذْهَبُونَ"},{"s":81,"a":27,"t":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ"},{"s":81,"a":28,"t":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ"},{"s":81,"a":29,"t":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ"}]}