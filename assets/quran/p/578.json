{"p":578,"juz":29,"ayat":[{"s":75,"a":20,"t":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"},{"s":75,"a":21,"t":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ"},{"s":75,"a":22,"t":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ"},{"s":75,"a":23,"t":"إِلَىٰ رَبِّهَا نَاظِرَةٌ"},{"s":75,"a":24,"t":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ"},{"s":75,"a":25,"t":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ"},{"s":75,"a":26,"t":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"},{"s":75,"a":27,"t":"وَقِيلَ مَنْ ۜ رَاقٍ"},{"s":75,"a":28,"t":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"},{"s":75,"a":29,"t":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"},{"s":75,"a":30,"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"},{"s":75,"a":31,"t":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"s":75,"a":32,"t":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ"},{"s":75,"a":33,"t":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"},{"s":75,"a":34,"t":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"s":75,"a":35,"t":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"},{"s":75,"a":36,"t":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى"},{"s":75,"a":37,"t":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ"},{"s":75,"a":38,"t":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"},{"s":75,"a":39,"t":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"s":75,"a":40,"t":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ"},{"s":76,"a":1,"t":" هَلْ أَتَىٰ عَلَى ٱلْإِنسَـٰنِ حِينٌ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًٔا مَّذْكُورًا"},{"s":76,"a":2,"t":"إِنَّا خَلَقْنَا ٱلْإِنسَـٰنَ مِن نُّطْفَةٍ أَمْشَاجٍ نَّبْتَلِيهِ فَجَعَلْنَـٰهُ سَمِيعًۢا بَصِيرًا"},{"s":76,"a":3,"t":"إِنَّا هَدَيْنَـٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا"},{"s":76,"a":4,"t":"إِنَّآ أَعْتَدْنَا لِلْكَـٰفِرِينَ سَلَـٰسِلَا۟ وَأَغْلَـٰلًا وَسَعِيرًا"},{"s":76,"a":5,"t":"إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍ كَانَ مِزَاجُهَا كَافُورًا"}]}