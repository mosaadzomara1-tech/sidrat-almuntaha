{"p":528,"juz":27,"ayat":[{"s":53,"a":45,"t":"وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ"},{"s":53,"a":46,"t":"مِن نُّطْفَةٍ إِذَا تُمْنَىٰ"},{"s":53,"a":47,"t":"وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ"},{"s":53,"a":48,"t":"وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ"},{"s":53,"a":49,"t":"وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ"},{"s":53,"a":50,"t":"وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ"},{"s":53,"a":51,"t":"وَثَمُودَا۟ فَمَآ أَبْقَىٰ"},{"s":53,"a":52,"t":"وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ"},{"s":53,"a":53,"t":"وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ"},{"s":53,"a":54,"t":"فَغَشَّىٰهَا مَا غَشَّىٰ"},{"s":53,"a":55,"t":"فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ"},{"s":53,"a":56,"t":"هَـٰذَا نَذِيرٌ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ"},{"s":53,"a":57,"t":"أَزِفَتِ ٱلْـَٔازِفَةُ"},{"s":53,"a":58,"t":"لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ"},{"s":53,"a":59,"t":"أَفَمِنْ هَـٰذَا ٱلْحَدِيثِ تَعْجَبُونَ"},{"s":53,"a":60,"t":"وَتَضْحَكُونَ وَلَا تَبْكُونَ"},{"s":53,"a":61,"t":"وَأَنتُمْ سَـٰمِدُونَ"},{"s":53,"a":62,"t":"فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩"},{"s":54,"a":1,"t":" ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ"},{"s":54,"a":2,"t":"وَإِن يَرَوْا۟ ءَايَةً يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌ مُّسْتَمِرٌّ"},{"s":54,"a":3,"t":"وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍ مُّسْتَقِرٌّ"},{"s":54,"a":4,"t":"وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ"},{"s":54,"a":5,"t":"حِكْمَةٌۢ بَـٰلِغَةٌ ۖ فَمَا تُغْنِ ٱلنُّذُرُ"},{"s":54,"a":6,"t":"فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍ نُّكُرٍ"}]}