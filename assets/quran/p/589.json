{"p":589,"juz":30,"ayat":[{"s":83,"a":35,"t":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ"},{"s":83,"a":36,"t":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ"},{"s":84,"a":1,"t":" إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ"},{"s":84,"a":2,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"s":84,"a":3,"t":"وَإِذَا ٱلْأَرْضُ مُدَّتْ"},{"s":84,"a":4,"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"s":84,"a":5,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"s":84,"a":6,"t":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ"},{"s":84,"a":7,"t":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ"},{"s":84,"a":8,"t":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"},{"s":84,"a":9,"t":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا"},{"s":84,"a":10,"t":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"},{"s":84,"a":11,"t":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا"},{"s":84,"a":12,"t":"وَيَصْلَىٰ سَعِيرًا"},{"s":84,"a":13,"t":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا"},{"s":84,"a":14,"t":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"s":84,"a":15,"t":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا"},{"s":84,"a":16,"t":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ"},{"s":84,"a":17,"t":"وَٱلَّيْلِ وَمَا وَسَقَ"},{"s":84,"a":18,"t":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ"},{"s":84,"a":19,"t":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ"},{"s":84,"a":20,"t":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"},{"s":84,"a":21,"t":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩"},{"s":84,"a":22,"t":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ"},{"s":84,"a":23,"t":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ"},{"s":84,"a":24,"t":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"},{"s":84,"a":25,"t":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"}]}