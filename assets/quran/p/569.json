{"p":569,"juz":29,"ayat":[{"s":70,"a":11,"t":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ"},{"s":70,"a":12,"t":"وَصَـٰحِبَتِهِۦ وَأَخِيهِ"},{"s":70,"a":13,"t":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ"},{"s":70,"a":14,"t":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ"},{"s":70,"a":15,"t":"كَلَّآ ۖ إِنَّهَا لَظَىٰ"},{"s":70,"a":16,"t":"نَزَّاعَةً لِّلشَّوَىٰ"},{"s":70,"a":17,"t":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ"},{"s":70,"a":18,"t":"وَجَمَعَ فَأَوْعَىٰٓ"},{"s":70,"a":19,"t":"۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا"},{"s":70,"a":20,"t":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا"},{"s":70,"a":21,"t":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا"},{"s":70,"a":22,"t":"إِلَّا ٱلْمُصَلِّينَ"},{"s":70,"a":23,"t":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ"},{"s":70,"a":24,"t":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ"},{"s":70,"a":25,"t":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ"},{"s":70,"a":26,"t":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ"},{"s":70,"a":27,"t":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"},{"s":70,"a":28,"t":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ"},{"s":70,"a":29,"t":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ"},{"s":70,"a":30,"t":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"},{"s":70,"a":31,"t":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ"},{"s":70,"a":32,"t":"وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ"},{"s":70,"a":33,"t":"وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ"},{"s":70,"a":34,"t":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"},{"s":70,"a":35,"t":"أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ"},{"s":70,"a":36,"t":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ"},{"s":70,"a":37,"t":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ"},{"s":70,"a":38,"t":"أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ"},{"s":70,"a":39,"t":"كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ"}]}