{"p":450,"juz":23,"ayat":[{"s":37,"a":103,"t":"فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ"},{"s":37,"a":104,"t":"وَنَـٰدَيْنَـٰهُ أَن يَـٰٓإِبْرَٰهِيمُ"},{"s":37,"a":105,"t":"قَدْ صَدَّقْتَ ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"s":37,"a":106,"t":"إِنَّ هَـٰذَا لَهُوَ ٱلْبَلَـٰٓؤُا۟ ٱلْمُبِينُ"},{"s":37,"a":107,"t":"وَفَدَيْنَـٰهُ بِذِبْحٍ عَظِيمٍ"},{"s":37,"a":108,"t":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"},{"s":37,"a":109,"t":"سَلَـٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ"},{"s":37,"a":110,"t":"كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"s":37,"a":111,"t":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},{"s":37,"a":112,"t":"وَبَشَّرْنَـٰهُ بِإِسْحَـٰقَ نَبِيًّا مِّنَ ٱلصَّـٰلِحِينَ"},{"s":37,"a":113,"t":"وَبَـٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَـٰقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِۦ مُبِينٌ"},{"s":37,"a":114,"t":"وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَـٰرُونَ"},{"s":37,"a":115,"t":"وَنَجَّيْنَـٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"},{"s":37,"a":116,"t":"وَنَصَرْنَـٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَـٰلِبِينَ"},{"s":37,"a":117,"t":"وَءَاتَيْنَـٰهُمَا ٱلْكِتَـٰبَ ٱلْمُسْتَبِينَ"},{"s":37,"a":118,"t":"وَهَدَيْنَـٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"},{"s":37,"a":119,"t":"وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْـَٔاخِرِينَ"},{"s":37,"a":120,"t":"سَلَـٰمٌ عَلَىٰ مُوسَىٰ وَهَـٰرُونَ"},{"s":37,"a":121,"t":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"s":37,"a":122,"t":"إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},{"s":37,"a":123,"t":"وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ"},{"s":37,"a":124,"t":"إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ"},{"s":37,"a":125,"t":"أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ ٱلْخَـٰلِقِينَ"},{"s":37,"a":126,"t":"ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ"}]}