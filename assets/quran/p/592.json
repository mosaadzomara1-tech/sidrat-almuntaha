{"p":592,"juz":30,"ayat":[{"s":87,"a":16,"t":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"},{"s":87,"a":17,"t":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ"},{"s":87,"a":18,"t":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"},{"s":87,"a":19,"t":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"},{"s":88,"a":1,"t":" هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ"},{"s":88,"a":2,"t":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ"},{"s":88,"a":3,"t":"عَامِلَةٌ نَّاصِبَةٌ"},{"s":88,"a":4,"t":"تَصْلَىٰ نَارًا حَامِيَةً"},{"s":88,"a":5,"t":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"},{"s":88,"a":6,"t":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ"},{"s":88,"a":7,"t":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ"},{"s":88,"a":8,"t":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ"},{"s":88,"a":9,"t":"لِّسَعْيِهَا رَاضِيَةٌ"},{"s":88,"a":10,"t":"فِى جَنَّةٍ عَالِيَةٍ"},{"s":88,"a":11,"t":"لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً"},{"s":88,"a":12,"t":"فِيهَا عَيْنٌ جَارِيَةٌ"},{"s":88,"a":13,"t":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ"},{"s":88,"a":14,"t":"وَأَكْوَابٌ مَّوْضُوعَةٌ"},{"s":88,"a":15,"t":"وَنَمَارِقُ مَصْفُوفَةٌ"},{"s":88,"a":16,"t":"وَزَرَابِىُّ مَبْثُوثَةٌ"},{"s":88,"a":17,"t":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ"},{"s":88,"a":18,"t":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ"},{"s":88,"a":19,"t":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ"},{"s":88,"a":20,"t":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ"},{"s":88,"a":21,"t":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ"},{"s":88,"a":22,"t":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ"},{"s":88,"a":23,"t":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"},{"s":88,"a":24,"t":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ"},{"s":88,"a":25,"t":"إِنَّ إِلَيْنَآ إِيَابَهُمْ"},{"s":88,"a":26,"t":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم"}]}