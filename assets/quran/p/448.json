{"p":448,"juz":23,"ayat":[{"s":37,"a":52,"t":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ"},{"s":37,"a":53,"t":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَدِينُونَ"},{"s":37,"a":54,"t":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"},{"s":37,"a":55,"t":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ"},{"s":37,"a":56,"t":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ"},{"s":37,"a":57,"t":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ"},{"s":37,"a":58,"t":"أَفَمَا نَحْنُ بِمَيِّتِينَ"},{"s":37,"a":59,"t":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ"},{"s":37,"a":60,"t":"إِنَّ هَـٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ"},{"s":37,"a":61,"t":"لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ"},{"s":37,"a":62,"t":"أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ"},{"s":37,"a":63,"t":"إِنَّا جَعَلْنَـٰهَا فِتْنَةً لِّلظَّـٰلِمِينَ"},{"s":37,"a":64,"t":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ"},{"s":37,"a":65,"t":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ"},{"s":37,"a":66,"t":"فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"},{"s":37,"a":67,"t":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ"},{"s":37,"a":68,"t":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ"},{"s":37,"a":69,"t":"إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ"},{"s":37,"a":70,"t":"فَهُمْ عَلَىٰٓ ءَاثَـٰرِهِمْ يُهْرَعُونَ"},{"s":37,"a":71,"t":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ"},{"s":37,"a":72,"t":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ"},{"s":37,"a":73,"t":"فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُنذَرِينَ"},{"s":37,"a":74,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"s":37,"a":75,"t":"وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ"},{"s":37,"a":76,"t":"وَنَجَّيْنَـٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"}]}