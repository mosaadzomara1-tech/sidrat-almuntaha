{"p":591,"juz":30,"ayat":[{"s":86,"a":1,"t":" وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"s":86,"a":2,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"},{"s":86,"a":3,"t":"ٱلنَّجْمُ ٱلثَّاقِبُ"},{"s":86,"a":4,"t":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"},{"s":86,"a":5,"t":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ"},{"s":86,"a":6,"t":"خُلِقَ مِن مَّآءٍ دَافِقٍ"},{"s":86,"a":7,"t":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"},{"s":86,"a":8,"t":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"},{"s":86,"a":9,"t":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"},{"s":86,"a":10,"t":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"},{"s":86,"a":11,"t":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"},{"s":86,"a":12,"t":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"},{"s":86,"a":13,"t":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ"},{"s":86,"a":14,"t":"وَمَا هُوَ بِٱلْهَزْلِ"},{"s":86,"a":15,"t":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"s":86,"a":16,"t":"وَأَكِيدُ كَيْدًا"},{"s":86,"a":17,"t":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"},{"s":87,"a":1,"t":" سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"},{"s":87,"a":2,"t":"ٱلَّذِى خَلَقَ فَسَوَّىٰ"},{"s":87,"a":3,"t":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ"},{"s":87,"a":4,"t":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"},{"s":87,"a":5,"t":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"},{"s":87,"a":6,"t":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"},{"s":87,"a":7,"t":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"},{"s":87,"a":8,"t":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"s":87,"a":9,"t":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"},{"s":87,"a":10,"t":"سَيَذَّكَّرُ مَن يَخْشَىٰ"},{"s":87,"a":11,"t":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى"},{"s":87,"a":12,"t":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"},{"s":87,"a":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"s":87,"a":14,"t":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ"},{"s":87,"a":15,"t":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"}]}